{
  "name": "rust",
  "version": "latest",
  "description": "Rust programming language via rustup",
  "aliases": ["cargo", "rustc", "rustup"],
  "build": {
    "toolchain": "shell",
    "steps": [
      "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o rustup.sh",
      "sh rustup.sh -y --no-modify-path",
      "mkdir -p bin",
      "cp ~/.cargo/bin/rustup bin/",
      "cp ~/.cargo/bin/cargo bin/",
      "cp ~/.cargo/bin/rustc bin/"
    ],
    "bin": "bin/cargo"
  }
}
